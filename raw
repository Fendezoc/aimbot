local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

--========================================================--
-- SETTINGS
--========================================================--

local CurrentMode = "Potato"
local AutoBoost = true

local Modes = {
	Low = {
		Particles = true,
		Shadows = true,
		PostFX = true,
		Transparency = 0,
	},

	Potato = {
		Particles = false,
		Shadows = false,
		PostFX = false,
		Transparency = 0.05,
	},

	Extreme = {
		Particles = false,
		Shadows = false,
		PostFX = false,
		Transparency = 0.15,
	}
}

--========================================================--
-- GRAPHICS
--========================================================--

local function DisablePostEffects()
	for _, obj in ipairs(Lighting:GetChildren()) do
		if obj:IsA("BloomEffect")
			or obj:IsA("BlurEffect")
			or obj:IsA("ColorCorrectionEffect")
			or obj:IsA("DepthOfFieldEffect")
			or obj:IsA("SunRaysEffect") then

			obj.Enabled = false
		end
	end
end

local function OptimizeLighting(mode)
	if mode == "Low" then
		Lighting.GlobalShadows = true
		Lighting.EnvironmentDiffuseScale = 1
		Lighting.EnvironmentSpecularScale = 1
	else
		Lighting.GlobalShadows = false
		Lighting.EnvironmentDiffuseScale = 0
		Lighting.EnvironmentSpecularScale = 0
	end

	if mode ~= "Low" then
		DisablePostEffects()
	end
end

--========================================================--
-- OBJECT OPTIMIZER
--========================================================--

local function OptimizeObject(obj, mode)

	if obj:IsA("BasePart") then

		if mode ~= "Low" then
			obj.CastShadow = false
		end

	elseif obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		obj.Enabled = Modes[mode].Particles

	elseif obj:IsA("Highlight") then

		if mode == "Extreme" then
			obj.Enabled = false
		end
	end
end

local function OptimizeWorld(mode)

	for _, obj in ipairs(workspace:GetDescendants()) do
		OptimizeObject(obj, mode)
	end

	OptimizeLighting(mode)
end

--========================================================--
-- STREAMING
--========================================================--

pcall(function()

	workspace.StreamingEnabled = true

	if CurrentMode == "Extreme" then
		workspace.StreamingMinRadius = 48
		workspace.StreamingTargetRadius = 96
	else
		workspace.StreamingMinRadius = 64
		workspace.StreamingTargetRadius = 128
	end

end)

--========================================================--
-- NEW OBJECTS
--========================================================--

workspace.DescendantAdded:Connect(function(obj)

	task.defer(function()

		if Modes[CurrentMode] then
			OptimizeObject(obj, CurrentMode)
		end

	end)

end)

--========================================================--
-- FPS COUNTER
--========================================================--

local FPS = 0
local Ping = 0

local frameCount = 0
local timer = 0

RunService.RenderStepped:Connect(function(dt)

	frameCount += 1
	timer += dt

	if timer >= 1 then

		FPS = math.floor(frameCount / timer)

		frameCount = 0
		timer = 0

		local Stats = game:GetService("Stats")

		pcall(function()
			Ping = math.floor(
				Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
			)
		end)

	end

end)

