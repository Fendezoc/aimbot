local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

-- Tầm nhìn
Lighting.FogStart = 0
Lighting.FogEnd = 20
Lighting.FogColor = Lighting.Ambient

-- Làm mờ hình ảnh 3D
local blur = Lighting:FindFirstChild("PotatoBlur")

if not blur then
    blur = Instance.new("BlurEffect")
    blur.Name = "PotatoBlur"
    blur.Size = 30
    blur.Parent = Lighting
end

-- Giảm chất lượng vật liệu
for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("BasePart") then
        obj.Material = Enum.Material.SmoothPlastic
        obj.Reflectance = 0
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency = 0.15
    end
end

-- Ánh sáng đơn giản hơn
Lighting.GlobalShadows = false
Lighting.EnvironmentDiffuseScale = 0
Lighting.EnvironmentSpecularScale = 0
Lighting.Brightness = 1

print("Potato Graphics: ON | View Distance: 20 studs")
