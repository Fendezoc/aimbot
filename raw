--========================================================--
-- AUTO FPS BOOST
--========================================================--

local LastBoost = 0

RunService.Heartbeat:Connect(function()

	if not AutoBoost then
		return
	end

	if os.clock() - LastBoost < 5 then
		return
	end

	if FPS > 0 and FPS < 30 then

		LastBoost = os.clock()

		if CurrentMode == "Low" then

			CurrentMode = "Potato"
			ModeLabel.Text = "Mode: Potato"
			OptimizeWorld("Potato")

		elseif CurrentMode == "Potato" then

			CurrentMode = "Extreme"
			ModeLabel.Text = "Mode: Extreme"
			OptimizeWorld("Extreme")

		end

	end

end)

--========================================================--
-- UPDATE GUI
--========================================================--

RunService.RenderStepped:Connect(function()

	StatsLabel.Text =
		"FPS: " .. FPS ..
		"\nPing: " .. Ping .. " ms"

end)

